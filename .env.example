# Bu dosyayı ".env" adıyla kopyalayın ve kendi anahtarlarınızı yazın.
# .env dosyası GitHub'a YÜKLENMEZ. Anahtarlarınızı kimseyle paylaşmayın.

# Google Cloud Console → YouTube Data API v3 → Kimlik bilgileri → API anahtarı
YOUTUBE_API_KEY=buraya_youtube_anahtari

# Google AI Studio → Get API key
GEMINI_API_KEY=buraya_gemini_anahtari
